{
    "name": "designpond/laravel-shoppingcart",
    "description": "A session-based shopping cart for Laravel 12 and 13, maintained by DesignPond.",
    "keywords": ["laravel", "shoppingcart", "cart"],
    "license": "MIT",
    "authors": [
        {
            "name": "Rob Gloudemans",
            "email": "info@robgloudemans.nl"
        },
        {
            "name": "DesignPond",
            "homepage": "https://github.com/DesignPond"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/events": "^12|^13",
        "illuminate/session": "^12|^13",
        "illuminate/support": "^12|^13"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10|^11",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "replace": {
        "hardevine/shoppingcart": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Gloudemans\\Shoppingcart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gloudemans\\Tests\\Shoppingcart\\": "tests/"
        }
    },
    "suggest": {
        "gloudemans/notify": "Simple flash notifications for Laravel"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Gloudemans\\Shoppingcart\\ShoppingcartServiceProvider"
            ],
            "aliases": {
                "Cart": "Gloudemans\\Shoppingcart\\Facades\\Cart"
            }
        }
    }
}
